# Copy to /srv/secrets/hetzner-box.env (mode 600). Never inside a clone:
# /srv/projects is mounted into Caddy.

# Cloudflare token for ACME DNS-01: Zone -> DNS -> Edit on EVERY zone any
# enabled fragment serves. A zone missing here fails issuance for its hosts
# silently. https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
# Let's Encrypt expiry warnings.
ACME_EMAIL=

# The box's MAIN public IPv4: Caddy binds :80/:443 here, orange-cloud records
# point here (Cloudflare hides it).
EDGE_IP=
# The box's Tailscale IP (`tailscale ip -4`): Caddy also binds here, for the
# grey-cloud tailnet_only hosts.
TAILNET_IP=
